<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.skillsphere</groupId>
    <artifactId>discovery-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>discovery-server</name>
    <description>
        Eureka service registry — Sprint 6's answer to "how does the gateway find
        a service instance." Every extracted service registers itself here on
        startup instead of being wired to a fixed host:port anywhere, which is
        what lets an instance restart on a different port, or a service run as
        two instances, without touching any other service's configuration.
    </description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Exposes /actuator/prometheus for Prometheus to scrape. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Distributed tracing: bridges Micrometer's Observation API (already
             used by actuator/RestClient/spring-kafka) to Brave, then reports spans
             to the Zipkin container in docker-compose.yml. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>
        <!-- Boot 4.x split tracing autoconfiguration out of the actuator
             starter into its own modules (the same pattern as
             spring-boot-http-client for RestClient timeouts): this module
             wires the Brave Tracer/Sampler beans, and spring-boot-zipkin
             below wires the HTTP sender that actually posts spans to the
             Zipkin container. Neither is pulled in transitively by the
             bridge/reporter deps above, confirmed by their absence from
             the actual dependency:tree output, not assumed. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-zipkin</artifactId>
        </dependency>
        <!-- The third and final piece: spring-boot-micrometer-tracing alone
             only wires generic ObservationHandlers against an
             io.micrometer.tracing.Tracer bean it expects to already exist -
             it never creates one. This module actually builds that Tracer
             (and Tracing/CurrentTraceContext) backed by Brave, and wires
             Brave's reporter to the Zipkin sender spring-boot-zipkin
             provides. Found the same way as the other two: the empty
             Zipkin services list after adding just the first two modules
             traced back to MicrometerTracingAutoConfiguration's
             constructor requiring a Tracer bean nothing was providing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
